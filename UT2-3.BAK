//WAP to calculate simple interest
#include<stdio.h>
#include<conio.h>

void main()
{
	float p,t,r,i,is;
	clrscr();

	printf("Enter the principle amount;");
	scanf("%f",&p);

	printf("Enter the rate of interest;");
	scanf("%f",&r);

	printf("Enter the time period");
	scanf("%f",&t);

	i=(p*r*t)/100;

	printf("The simple interest is: %f",i);
	getch();
}